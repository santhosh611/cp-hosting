# ============================================================
#  Root .gitignore — covers both frontend/ and backend/
# ============================================================

# ── Node modules ─────────────────────────────────────────────
node_modules/
frontend/node_modules/
backend/node_modules/

# ── Environment files ─────────────────────────────────────────
.env
.env.*
frontend/.env
frontend/.env.*
backend/.env
backend/.env.*
!.env.example
!frontend/.env.example
!backend/.env.example

# ── Build outputs ─────────────────────────────────────────────
frontend/build/
backend/dist/
backend/public/

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
logs/

# ── OS / Editor files ─────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Uploads (user-uploaded files) ────────────────────────────
backend/uploads/

# ── Misc ──────────────────────────────────────────────────────
*.pem
.npm
.cache/
